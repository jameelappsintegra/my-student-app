# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string. Enrolment uses transactions, so this must be a
# replica set (every MongoDB Atlas cluster is one).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/student_manager?retryWrites=true&w=majority

# Comma-separated browser origins allowed to call the API (scheme://host[:port]).
CORS_ORIGIN=http://localhost:3000

# Optional
# LOG_LEVEL=info            # fatal | error | warn | info | debug | trace | silent
# TRUST_PROXY=1             # number of reverse proxies in front of the API
# RATE_LIMIT_MAX=300        # requests per IP per 15 minutes on /api
# SHUTDOWN_TIMEOUT_MS=10000 # time allowed to drain requests on SIGTERM
