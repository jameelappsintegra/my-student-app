# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string. Admission enrolment uses transactions,
# so this must point at a replica set (MongoDB Atlas clusters are replica sets).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/student_manager?retryWrites=true&w=majority

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
