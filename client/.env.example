# Address the Next.js server uses to reach the EduPro API. Read at BUILD time
# (rewrites are baked into the build), so rebuild after changing it.
API_INTERNAL_URL=http://localhost:5000

# Leave unset to call the API through the same origin (/api), which the
# session cookie requires. Only NEXT_PUBLIC_ values reach the browser:
# never put secrets in them.
# NEXT_PUBLIC_API_URL=/api
